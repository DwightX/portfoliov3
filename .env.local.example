# Copy to .env.local and fill in real values. Do NOT commit .env.local.
# On Netlify, set these same vars in: Site settings -> Environment variables.

# Groq — sign up at https://console.groq.com, create an API key
GROQ_API_KEY=

# Upstash Redis — sign up at https://console.upstash.com, create a Redis DB,
# then copy the REST URL and REST token from the database details page
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — sign up at https://dash.cloudflare.com,
# go to Turnstile, add a new site (managed mode), then copy:
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public origin of the deployed site (used for CORS / referer checks).
# In dev this can stay blank; localhost is allowlisted automatically.
NEXT_PUBLIC_SITE_ORIGIN=https://yourdomain.com
